# Application
APP_NAME=AuthForge
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:8000
REQUIRE_EMAIL_VERIFICATION=False

# Database - use either DATABASE_URL or DB_* split
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/authforge
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=authforge
# DB_USER=postgres
# DB_PASSWORD=postgres

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# CORS (comma-separated)
CORS_ORIGINS=

# Admin seeding (for scripts/seed_admin.py and tests)
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=ChangeMe123!
